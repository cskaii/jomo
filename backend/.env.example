APP_ENV=development
APP_NAME=JOMO
DATABASE_URL=sqlite:///./jomo_dev.db
MIGRATION_DATABASE_URL=
AUTH_PROVIDER=supabase
AUTH_ISSUER_URL=
AUTH_PUBLIC_KEY=
# Backend only: Supabase Settings > API Keys > Secret keys (sb_secret_...).
# Needed for account deletion. Never use a NEXT_PUBLIC_ variable for this key.
SUPABASE_SECRET_KEY=
AUTH_AUDIENCE=authenticated
DEV_AUTH_ENABLED=false
AUTO_SEED_CATALOG=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_PRESIDIO_ENABLED=true
AI_SPACY_MODEL=en_core_web_sm
REQUEST_MAX_BODY_BYTES=3145728
