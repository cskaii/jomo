FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    APP_ENV=production SERVERLESS_MODE=true AI_SPACY_MODEL=en_core_web_sm AI_PRESIDIO_ENABLED=true \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MPLCONFIGDIR=/tmp/matplotlib PORT=8000

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-eng libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m spacy download en_core_web_sm
COPY . .
RUN useradd --create-home --uid 10001 jomo && chown -R jomo:jomo /app
USER jomo
EXPOSE 8000
# Database migrations are an explicit operator step, never per cold start.
CMD ["sh", "-c", "exec uvicorn app.main:app --no-access-log --host 0.0.0.0 --port ${PORT:-8000}"]
